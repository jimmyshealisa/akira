<brls:Box
    width="100%"
    height="100%"
    axis="column"
    alignItems="center"
    justifyContent="center"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="@i18n/akira/wg_import/title"
        fontSize="28"
        textColor="@theme/brls/text"
        horizontalAlign="center"
        marginBottom="10"/>

    <brls:Label
        text="@i18n/akira/wg_import/instructions"
        fontSize="18"
        textColor="@theme/akira/text_muted"
        horizontalAlign="center"
        marginBottom="30"
        width="760"/>

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        alignItems="center"
        justifyContent="center"
        marginBottom="18">

        <brls:Label
            id="wgimport/addrIp"
            text=""
            fontSize="26"/>

        <brls:Label
            text="·"
            fontSize="26"
            textColor="@theme/akira/surface_line"
            marginLeft="12"
            marginRight="12"/>

        <brls:Label
            id="wgimport/addrPort"
            text=""
            fontSize="26"/>
    </brls:Box>

    <brls:Label
        id="wgimport/code"
        text="0 0 0 0"
        fontSize="64"
        textColor="@theme/brls/text"
        horizontalAlign="center"/>

    <brls:Label
        id="wgimport/timer"
        text=""
        fontSize="16"
        textColor="@theme/akira/accent"
        horizontalAlign="center"
        marginTop="16"/>

    <brls:Label
        id="wgimport/status"
        text="@i18n/akira/wg_import/status_waiting"
        fontSize="20"
        textColor="@theme/akira/text_muted"
        horizontalAlign="center"
        marginTop="10"
        marginBottom="24"/>

    <brls:Button
        id="wgimport/close"
        text="@i18n/akira/common/close"
        style="bordered"/>

</brls:Box>
