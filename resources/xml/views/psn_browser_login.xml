<brls:Box
    width="100%"
    height="100%"
    axis="row"
    alignItems="center"
    justifyContent="center"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="50"
    paddingRight="50"
    paddingBottom="30">

    <brls:Box
        id="psnlogin/qrSlot"
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        marginRight="44"/>

    <brls:Box
        width="580"
        height="auto"
        axis="column"
        justifyContent="center">

        <brls:Label
            text="@i18n/akira/psn_login/title"
            fontSize="28"
            textColor="@theme/brls/text"
            marginBottom="18"/>

        <brls:Label
            text="@i18n/akira/psn_login/step1"
            fontSize="18"
            textColor="@theme/akira/text_muted"
            marginBottom="10"/>

        <brls:Label
            text="@i18n/akira/psn_login/step2"
            fontSize="18"
            textColor="@theme/akira/text_muted"
            marginBottom="10"/>

        <brls:Label
            text="@i18n/akira/psn_login/step3"
            fontSize="18"
            textColor="@theme/akira/text_muted"
            marginBottom="10"/>

        <brls:Label
            text="@i18n/akira/psn_login/example"
            fontSize="15"
            textColor="@theme/akira/accent"
            marginBottom="20"/>

        <brls:Label
            id="psnlogin/status"
            text="@i18n/akira/psn_login/status_waiting"
            fontSize="18"
            textColor="@theme/akira/text_muted"
            marginBottom="24"/>

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center">

            <brls:Button
                id="psnlogin/enter"
                text="@i18n/akira/psn_login/enter_code"
                style="primary"
                marginRight="16"/>

            <brls:Button
                id="psnlogin/close"
                text="@i18n/akira/common/close"
                style="bordered"/>
        </brls:Box>
    </brls:Box>

</brls:Box>
